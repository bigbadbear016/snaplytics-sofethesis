# --- Same DB as Django (Snaplytics settings.py DATABASES), embedded at build time (EXPO_PUBLIC_*) ---
EXPO_PUBLIC_USE_SUPABASE_POOLER=true
EXPO_PUBLIC_DB_HOST=your-pooler-host.pooler.supabase.com
EXPO_PUBLIC_DB_PORT=5432
EXPO_PUBLIC_DB_NAME=postgres
EXPO_PUBLIC_DB_USER=postgres.your_project_ref
EXPO_PUBLIC_DB_PASSWORD=your_database_password

# --- PostgREST fallback when pooler mode is false ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt

# --- Standalone booking confirmation email (SMTP on device, no Django server) ---
# Copy the same values from Snaplytics .env (HEIGEN_SMTP_* or EMAIL_*).
EXPO_PUBLIC_SMTP_HOST=smtp.gmail.com
EXPO_PUBLIC_SMTP_PORT=587
EXPO_PUBLIC_SMTP_USE_TLS=true
EXPO_PUBLIC_SMTP_USER=your-smtp-user@gmail.com
EXPO_PUBLIC_SMTP_PASSWORD=your_app_password_no_spaces
EXPO_PUBLIC_SMTP_FROM_EMAIL=your-smtp-user@gmail.com
EXPO_PUBLIC_SMTP_FROM_NAME=Heigen Studio

# Optional JDBC POC screen defaults (Android)
# EXPO_PUBLIC_PG_JDBC_URL=jdbc:postgresql://....pooler.supabase.com:5432/postgres?sslmode=require
# EXPO_PUBLIC_PG_USER=
# EXPO_PUBLIC_PG_PASSWORD=
