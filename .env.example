# Snaplytics backend settings. Copy to .env (same folder) and fill in real values.
# .env is git-ignored; never commit real passwords or API keys.
# Loaded by Snaplytics/Snaplytics/settings.py and Snaplytics/backup_db.py.

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.example.com
DB_PORT=5432
# require (default) for hosted Postgres; use disable for a local server without SSL
DB_SSLMODE=require

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Gmail: smtp.gmail.com, port 587, TLS on, and an App Password (not your login password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
# Use SSL instead of TLS (port 465). Leave false when EMAIL_USE_TLS=true.
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=you@example.com

# Name shown as the sender in the inbox (default: Heigen Studio)
EMAIL_SENDER_NAME=Heigen Studio
# The sender's profile picture can't be set here: Gmail shows the Google account photo
# of EMAIL_HOST_USER, so change it in that account's Google profile.

# Optional: public image URLs used in booking/coupon emails
# HEIGEN_EMAIL_LOGO_URL=https://example.com/logo.png
# HEIGEN_EMAIL_BANNER_URL=https://example.com/banner.jpg

# ── AI (Groq) ────────────────────────────────────────────────────────────
# One key, or several comma-separated (key1,key2,key3): the app rotates them and
# switches to the next key when one is rate-limited or fails. Get keys at console.groq.com.
# Leave empty to turn the AI features off.
GROQ_API_KEY=gsk_your-key-1,gsk_your-key-2
# Optional: model name (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# ── Scheduled jobs (optional) ────────────────────────────────────────────
# Shared secret the cron caller must send to the coupon cron endpoint
# CRON_SECRET=some-long-random-string
# Coupon ID used by: python manage.py suggest_coupons_for_at_risk
# COUPON_AT_RISK_ID=1
