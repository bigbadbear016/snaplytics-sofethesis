    %% Matches Snaplytics/backend/models.py (Django app "backend").
    %% Roles come from USER flags: is_superuser = OWNER, is_staff = ADMIN, otherwise STAFF.
    %% PACKAGE.category holds the CATEGORY name (text), not a foreign key.
    %% LOYALTY_SETTINGS is a single row; STAGING_BOOKING holds raw import rows. Neither links to other tables.

    USER {
        int id PK
        string username UK
        string email
        boolean is_staff
        boolean is_superuser
        boolean is_active
    }

    STAFF_PROFILE {
        int id PK
        int user_id FK
        boolean must_change_password
        boolean profile_completed
        string nickname
        boolean dev_mode
        datetime deleted_at
    }

    PASSWORD_RESET_REQUEST {
        int id PK
        int user_id FK
        string requested_email
        string status
        int reviewed_by_id FK
        datetime requested_at
    }

    CUSTOMER {
        int customer_id PK
        string full_name
        string email UK
        string contact_number
        string consent
        decimal loyalty_points
        int package_id FK
        datetime registration_date
        datetime deleted_at
    }

    CATEGORY {
        int id PK
        string name UK
        boolean is_archived
        datetime deleted_at
    }

    PACKAGE {
        int id PK
        string category
        string name
        float price
        float promo_price
        int max_people
        boolean is_archived
        datetime deleted_at
    }

    ADDON {
        int id PK
        string name
        float price
        string applies_to
        datetime deleted_at
    }

    BOOKING {
        int id PK
        int customer_id FK
        int package_id FK
        int coupon_id FK
        datetime session_date
        float total_price
        float gcash_payment
        float cash_payment
        string discounts
        float coupon_discount_amount
        string session_status
        boolean loyalty_points_credited
    }

    BOOKING_ADDON {
        int id PK
        int booking_id FK
        int addon_id FK
        int addon_quantity
        float addon_price
        float total_addon_cost
    }

    COUPON {
        int id PK
        string code UK
        string discount_type
        float discount_value
        float max_discount_amount
        int use_limit
        int per_customer_limit
        datetime expires_at
    }

    COUPON_USAGE {
        int id PK
        int coupon_id FK
        int customer_id FK
        int booking_id FK
        float discount_amount
        datetime used_at
    }

    COUPON_SENT {
        int id PK
        int coupon_id FK
        int customer_id FK
        string sender_label
        datetime sent_at
        datetime email_sent_at
    }

    EMAIL_TEMPLATE {
        int id PK
        int user_id FK
        string name
        text subject
        text body
    }

    ACTION_LOG {
        int id PK
        int actor_user_id FK
        string action_type
        text action_text
        json metadata
        datetime created_at
    }

    RENEWAL {
        int id PK
        int customer_id FK
        int total_bookings
        float avg_booking_value
        float booking_frequency
        boolean renewed_within_366
        float total_spent
        string preferred_package_type
    }

    LOYALTY_SETTINGS {
        int id PK
        decimal pesos_per_point_earn
        decimal pesos_per_point_redeem
    }

    STAGING_BOOKING {
        int id PK
        string file_name
        int raw_row_number
        json raw_data
        string processing_status
    }

    USER ||--o| STAFF_PROFILE : has
    USER o|--o{ PASSWORD_RESET_REQUEST : requests
    USER ||--o{ EMAIL_TEMPLATE : creates
    USER o|--o{ ACTION_LOG : performs

    CATEGORY ||..o{ PACKAGE : "groups (by name)"
    PACKAGE |o--o{ CUSTOMER : "claimed with points"

    CUSTOMER ||--o{ BOOKING : places
    PACKAGE |o--o{ BOOKING : "selected in"
    BOOKING ||--o{ BOOKING_ADDON : contains
    ADDON ||--o{ BOOKING_ADDON : "added in"

    COUPON |o--o{ BOOKING : "applied to"
    COUPON ||--o{ COUPON_USAGE : "redeemed in"
    CUSTOMER ||--o{ COUPON_USAGE : uses
    BOOKING ||--o{ COUPON_USAGE : records
    COUPON ||--o{ COUPON_SENT : "sent as"
    CUSTOMER ||--o{ COUPON_SENT : receives

    CUSTOMER ||--o| RENEWAL : "has return-visit profile"
