%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, Segoe UI, Arial","primaryColor":"#EEF2FF","primaryBorderColor":"#4F46E5","primaryTextColor":"#1F2937","lineColor":"#64748B","secondaryColor":"#ECFEFF","tertiaryColor":"#F8FAFC"},"flowchart":{"curve":"basis","nodeSpacing":42,"rankSpacing":58,"padding":12}}}%%
flowchart LR
    subgraph External["External Entities"]
        Customer["Customer"]
        Staff["Staff / Admin / Owner"]
        Email["Email Server (SMTP)"]
    end

    subgraph System["System Boundary"]
        Snaplytics["Snaplytics Platform"]
    end

    Customer -- "Email, contact details, package and add-on choices, coupon code" --> Snaplytics
    Snaplytics -- "Package recommendations, prices, booking confirmation" --> Customer

    Staff -- "Booking status updates, catalog and coupon changes, accounts, model retraining" --> Snaplytics
    Snaplytics -- "Dashboards, customer list with return chances, action logs" --> Staff

    Snaplytics -- "Confirmation, receipt, and coupon emails" --> Email
    Email -- "Send success or failure" --> Snaplytics

    classDef ext fill:#EEF2FF,stroke:#4F46E5,color:#1E1B4B,stroke-width:1.3px;
    classDef sys fill:#ECFEFF,stroke:#0E7490,color:#164E63,stroke-width:1.4px;

    class Customer,Staff,Email ext;
    class Snaplytics sys;
