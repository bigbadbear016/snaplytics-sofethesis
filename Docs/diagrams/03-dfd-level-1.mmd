%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, Segoe UI, Arial","primaryColor":"#EEF2FF","primaryBorderColor":"#4F46E5","primaryTextColor":"#1F2937","lineColor":"#64748B","secondaryColor":"#ECFEFF","tertiaryColor":"#F8FAFC"},"flowchart":{"curve":"basis","nodeSpacing":42,"rankSpacing":58,"padding":12}}}%%
flowchart LR
    subgraph External["External Entities"]
        extC["Customer"]
        extS["Staff / Admin / Owner"]
        extE["Email Server (SMTP)"]
    end

    subgraph Processes["Core Processes"]
        p1["1.0 Identify Customer<br/>(find by email or register)"]
        p2["2.0 Recommend Packages"]
        p3["3.0 Create Booking<br/>(package, add-ons, coupon, loyalty claim)"]
        p4["4.0 Manage Bookings<br/>(accept, complete, earn points)"]
        p5["5.0 Manage Catalog and Promotions"]
        p6["6.0 Predict Return Visits and Show Analytics"]
        p7["7.0 Train Models<br/>(run by hand)"]
        p8["8.0 Send Emails"]
    end

    subgraph DataStores["Data Stores"]
        d1[("D1 Customers")]
        d2[("D2 Bookings and Add-ons")]
        d3[("D3 Catalog<br/>Categories, Packages, Add-ons")]
        d4[("D4 Coupons and Loyalty Settings")]
        d5[("D5 Saved Models<br/>XGBoost + SVD++")]
        d6[("D6 Action Logs")]
    end

    extC -- "Email and details" --> p1
    p1 <--> d1
    p1 --> p2

    d2 --> p2
    d3 --> p2
    d5 --> p2
    p2 -- "Three package cards" --> extC

    extC -- "Choices and coupon code" --> p3
    d3 --> p3
    d4 --> p3
    p3 -- "Pending booking" --> d2
    p3 --> p8

    extS -- "Status updates" --> p4
    p4 <--> d2
    p4 -- "Loyalty points" --> d1
    p4 --> p8
    p4 --> d6

    extS -- "Catalog and coupon changes" --> p5
    p5 <--> d3
    p5 <--> d4
    p5 --> d6

    d1 --> p6
    d2 --> p6
    d5 --> p6
    p6 -- "Return chances, groups, dashboards" --> extS

    extS -- "Retrain command" --> p7
    d2 --> p7
    p7 --> d5

    p8 -- "Confirmation, receipt, coupons" --> extE

    classDef ext fill:#EEF2FF,stroke:#4F46E5,color:#1E1B4B,stroke-width:1.3px;
    classDef proc fill:#ECFEFF,stroke:#0E7490,color:#164E63,stroke-width:1.3px;
    classDef store fill:#F8FAFC,stroke:#475569,color:#1E293B,stroke-width:1.3px;

    class extC,extS,extE ext;
    class p1,p2,p3,p4,p5,p6,p7,p8 proc;
    class d1,d2,d3,d4,d5,d6 store;
